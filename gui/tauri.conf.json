{
  "$schema": "https://schema.tauri.app/config/2",
  "identifier": "com.secwin.gui",
  "version": "1.0.0",
  "productName": "SecWin",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SecWin - Modern Kali Tooling on Windows",
        "width": 1400,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 700,
        "center": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    }
  },
  "plugins": {
    "dialog": {
      "all": true
    },
    "fs": {
      "all": true,
      "scope": ["$APPDATA/**", "$HOME/**", "$TEMP/**"]
    },
    "shell": {
      "all": true,
      "open": true,
      "scope": {
        "allow": [
          "secwin*",
          "cmd*",
          "powershell*",
          "wsl*",
          "nmap*",
          "nuclei*",
          "subfinder*",
          "httpx*",
          "naabu*",
          "ffuf*",
          "gobuster*"
        ]
      }
    }
  }
}