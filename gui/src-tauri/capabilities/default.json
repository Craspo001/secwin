{
  "$schema": "https://schema.tauri.app/config/2",
  "identifier": "default",
  "description": "Default capabilities for SecWin GUI",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "shell:allow-run-secwin",
    "fs:allow-app-config",
    "fs:allow-app-data",
    "fs:allow-home",
    "fs:allow-temp",
    "dialog:allow-open",
    "dialog:allow-save",
    "opener:allow-open",
    "process:allow-exit"
  ]
}