{
  "$schema": "https://schema.tauri.app/config/2",
  "identifier": "com.secwin.gui",
  "version": "1.0.0",
  "productName": "SecWin",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SecWin - Modern Kali Tooling on Windows",
        "width": 1400,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 700,
        "center": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.svg",
      "icons/icon.ico",
      "icons/128x128.png",
      "icons/256x256.png",
      "icons/icon.icns"
    ],
    "windows": {
      "wix": {
        "language": "en-US",
        "template": "templates/wix/template.wxs"
      },
      "nsis": {
        "installerIcon": "icons/icon.ico"
      }
    },
    "macOS": {
      "entitlements": "entitlements.plist",
      "exceptionDomain": "",
      "frameworks": [],
      "providerShortName": "SecWin",
      "signingIdentity": null
    },
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libayatana-appindicator3-1", "librsvg2-common"]
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  }
}